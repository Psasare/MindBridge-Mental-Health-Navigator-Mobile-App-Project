generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  password          String
  name              String
  studentId         String?
  phoneNumber       String?
  profileImage      String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  username          String?            @unique
  assessmentResults AssessmentResult[]
  chatMessages      ChatMessage[]
  communityPosts    CommunityPost[]
  journalEntries    Journal[]
  moodLogs          MoodLog[]
  onboarding          Onboarding?
  mentalStateLogs     MentalStateLog[]
  userResourceHistory UserResourceHistory[]
  dailyGoalSets       DailyGoalSet[]
  goalCompletions     GoalCompletion[]
  gamification        UserGamification?
  communityHugs       CommunityHug[]
}

model Onboarding {
  id                    String   @id @default(uuid())
  userId                String   @unique
  firstName             String?
  university            String?
  program               String?
  level                 String?
  preferredLanguage     String?
  communicationStyle    String?
  spiritualBackground   String?
  interests             String[]
  currentAcademicSeason String?
  primaryGoals          String[]
  currentMood           String
  sleepPattern          String
  stressLevel           Int
  completedAt           DateTime @default(now())
  stressSources         String[]
  supportTypes          String[]
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MoodLog {
  id               String   @id @default(uuid())
  userId           String
  score            Int
  emotions         String[]
  energyLevel      Int?
  sleepHours       Float?
  sleepQuality     String?
  socialSetting    String?
  physicalSymptoms String[]
  weather          String?
  location         String?
  audioUrl         String?
  note             String?
  steps            Int?
  facialMetrics    Json?
  vocalMetrics     Json?
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Journal {
  id        String   @id @default(uuid())
  userId    String
  title     String?
  content   String
  mood      String?
  audioUrl  String?
  vocalMetrics Json?
  aiAnalysis String?
  aiFeedback String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CommunityPost {
  id          String         @id @default(uuid())
  userId      String
  group       String
  content     String
  hugs        Int            @default(0)
  isAnonymous Boolean        @default(true)
  createdAt   DateTime       @default(now())
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  hugRecords  CommunityHug[]
}

model CommunityHug {
  id        String        @id @default(uuid())
  userId    String
  postId    String
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model AssessmentResult {
  id        String   @id @default(uuid())
  userId    String
  type      String
  score     Int
  severity  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Resource {
  id                 String   @id @default(uuid())
  title              String
  type               String
  category           String?
  subcategory        String?
  duration           String?
  author             String?
  url                String?
  color              String?
  urgency            String?
  format             String?
  effectiveness      Float?
  campusAvailability String[]
  timeRequired       String?
  languages          String[]
  createdAt          DateTime @default(now())
  userHistory        UserResourceHistory[]
}

model ChatMessage {
  id        String   @id @default(uuid())
  userId    String
  role      String
  content   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MentalStateLog {
  id                 String   @id @default(uuid())
  userId             String
  primaryState       String
  subStates          String[]
  severity           Int
  confidence         Float?
  secondaryStates    Json?
  emotions           String[]
  triggers           String[]
  physicalIndicators Json?
  conditionScores    Json?
  actionRequired     String?
  supportLevel       String?
  crisisAlert        Boolean  @default(false)
  createdAt          DateTime @default(now())
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserResourceHistory {
  id              String   @id @default(uuid())
  userId          String
  resourceId      String
  timesUsed       Int      @default(0)
  userRating      Float?
  lastUsedAt      DateTime?
  condition       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource        Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceId])
}

model Goal {
  id              String   @id @default(uuid())
  condition       String   // anxiety, depression, stress, loneliness, academic_pressure
  category        String   // grounding, planning, connection, etc.
  variant         String   // identifier for the variant
  name            String
  description     String
  duration        Int      // typical duration in minutes
  difficulty      Int      // 1-5 scale
  whyItHelps      String
  points          Int      @default(10)
  badgeUnlock     String?
  createdAt       DateTime @default(now())
  completions     GoalCompletion[]
}

model DailyGoalSet {
  id              String   @id @default(uuid())
  userId          String
  date            DateTime @default(dbgenerated("CURRENT_DATE"))
  goalIds         String[]
  completedIds    String[]
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GoalCompletion {
  id              String   @id @default(uuid())
  userId          String
  goalId          String
  timeSpent       Int      // in seconds
  rating          Int?     // 1-5
  stateBefore     String?
  stateAfter      String?
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal            Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
}

model UserGamification {
  id              String   @id @default(uuid())
  userId          String   @unique
  totalPoints     Int      @default(0)
  currentStreak   Int      @default(0)
  longestStreak   Int      @default(0)
  badges          String[]
  lastCompletedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
