{
  "name": "mindbridge-workspace",
  "version": "1.0.0",
  "scripts": {
    "dev:all": "concurrently --kill-others-on-fail --raw \"npm run dev:backend\" \"npm run dev:mobile\"",
    "dev:backend": "npm --prefix mindbridge-backend run dev",
    "dev:mobile": "npm --prefix mindbridge-mobile run start",
    "dev:mobile:clean": "npm --prefix mindbridge-mobile run start -- --clear",
    "build:backend": "npm --prefix mindbridge-backend run build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0"
  }
}
